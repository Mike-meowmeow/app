# Copy to .env and fill in local values. Never commit real credentials.
DJANGO_SECRET_KEY=<generate-a-long-random-value>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=evsu_recruitment_dev
DB_USER=evsu_dev
DB_PASSWORD=<local-database-password>
DB_HOST=127.0.0.1
DB_PORT=3306

# Accounts and sessions
SESSION_IDLE_TIMEOUT_MINUTES=30
PASSWORD_RESET_TIMEOUT_MINUTES=60
EMAIL_VERIFICATION_TIMEOUT_HOURS=48
PRIVACY_NOTICE_VERSION=DRAFT-2026-11
DEFAULT_FROM_EMAIL=EVSU Recruitment <no-reply@localhost>

# Applications and documents
CORRECTION_WINDOW_DAYS=5
# Optional malware scanner; the file path is appended (exit 0 = clean, 1 = infected).
# Example: clamscan --no-summary   Empty = files are recorded as "not scanned".
MALWARE_SCAN_COMMAND=

# Official roster: may the HR preparer also approve their own roster?
# Institutional decision pending; refused (False) until HR confirms.
ROSTER_ALLOW_SELF_APPROVAL=False

# Notifications and email (console backend prints emails in the runserver terminal).
# For SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and the EMAIL_* keys.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_MAX_ATTEMPTS=3
SITE_URL=http://127.0.0.1:8000

# Operations (Stage 9). Production values are in .env.production.example.
BACKUP_ROOT=
MYSQL_BIN_DIR=
BACKUP_MAX_AGE_HOURS=26
TRUSTED_PROXIES=
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=20
PRIVATE_FILE_DELIVERY=django
