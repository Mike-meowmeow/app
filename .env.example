# Copy to .env and fill in local values. Never commit real credentials.
DJANGO_SECRET_KEY=<generate-a-long-random-value>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=evsu_recruitment_dev
DB_USER=evsu_dev
DB_PASSWORD=<local-database-password>
DB_HOST=127.0.0.1
DB_PORT=3306

# Accounts and sessions
SESSION_IDLE_TIMEOUT_MINUTES=30
PASSWORD_RESET_TIMEOUT_MINUTES=60
EMAIL_VERIFICATION_TIMEOUT_HOURS=48
PRIVACY_NOTICE_VERSION=DRAFT-2026-11
DEFAULT_FROM_EMAIL=EVSU Recruitment <no-reply@localhost>

# Applications and documents
CORRECTION_WINDOW_DAYS=5
# Optional malware scanner; the file path is appended (exit 0 = clean, 1 = infected).
# Example: clamscan --no-summary   Empty = files are recorded as "not scanned".
MALWARE_SCAN_COMMAND=
