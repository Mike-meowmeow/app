# Production / staging .env (Linux server). Copy to /srv/evsu-recruitment/.env,
# fill in real values, chmod 600, and never commit it. See deploy/DEPLOY.md.
DJANGO_SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(64))">
DJANGO_DEBUG=False
# Host names and CSRF origins are per site: see deploy/public.env.example and
# deploy/staff.env.example. SITE_PORTAL is set by the systemd unit.
PUBLIC_SITE_URL=https://apply.example.edu.ph
STAFF_SITE_URL=https://recruit-staff.example.edu.ph

# Behind Nginx on the same machine
BEHIND_PROXY=True
TRUSTED_PROXIES=127.0.0.1
PRIVATE_FILE_DELIVERY=nginx

DB_NAME=evsu_recruitment
DB_USER=evsu_app
DB_PASSWORD=<database password>
DB_HOST=127.0.0.1
DB_PORT=3306

PRIVATE_STORAGE_ROOT=/srv/evsu-recruitment/private
STATIC_ROOT=/srv/evsu-recruitment/staticfiles
BACKUP_ROOT=/srv/evsu-recruitment-backups
LOG_DIR=/var/log/evsu-recruitment

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp host>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp user>
EMAIL_HOST_PASSWORD=<smtp password>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EVSU-Ormoc Recruitment <recruitment@example.edu.ph>

SESSION_IDLE_TIMEOUT_MINUTES=30
PRIVACY_NOTICE_VERSION=<HR-approved notice version>
ROSTER_ALLOW_SELF_APPROVAL=False
MALWARE_SCAN_COMMAND=clamdscan --no-summary --fdpass
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=20
# Staff sign in from the internet; raise only if many staff share one address.
STAFF_LOGIN_MAX_FAILURES_PER_IP=20
# Staff confirm every sign-in with an authenticator app code (on by default when
# DJANGO_DEBUG=False). Keep it on for an internet-facing staff site.
STAFF_TWO_FACTOR_REQUIRED=True
TWO_FACTOR_ISSUER=EVSU Recruitment
