[Unit]
Description=EVSU recruitment production: nightly backup set (database + private files)

[Service]
Type=oneshot
User=evsuprod
WorkingDirectory=/srv/evsu-prod
ExecStart=/srv/evsu-prod/.venv/bin/python manage.py backup_create
ExecStartPost=/srv/evsu-prod/.venv/bin/python manage.py backup_verify
